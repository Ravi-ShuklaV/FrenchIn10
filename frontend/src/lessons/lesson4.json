      {
        "conceptId": "imperative_tu",
        "type": "grammar",
        "title": "Giving instructions with the imperative (tu form)",
        "explanation": "To give an instruction to one person informally, drop \"tu\" and remove the final -s from -er verbs: \"Chante !\" (Sing!), \"Respire !\" (Breathe!).",
        "examples": [
          {
            "french": "Chante plus fort !",
            "english": "Sing louder!"
          },
          {
            "french": "Respire profondément !",
            "english": "Breathe deeply!"
          }
        ],
        "questions": [
          {
            "question": "Which is the correct imperative form of \"chanter\" for \"tu\"?",
            "options": [
              "Chante !",
              "Chantes !",
              "Chanter !",
              "Tu chante !"
            ],
            "correctAnswer": "Chante !"
          }
        ]
      },
      {
        "conceptId": "avoir_une_belle_voix",
        "type": "grammar",
        "title": "Avoir + noun to describe qualities",
        "explanation": "French uses \"avoir\" (to have) where English often uses \"to be\": \"tu as une belle voix\" literally means \"you have a beautiful voice\".",
        "examples": [
          {
            "french": "Tu as une belle voix.",
            "english": "You have a beautiful voice."
          }
        ],
        "questions": [
          {
            "question": "Complete: Tu ___ une belle voix.",
            "options": [
              "as",
              "es",
              "avoir",
              "ai"
            ],
            "correctAnswer": "as"
          }
        ]
      }
