  "learning": {
    "vocabulary": [
      {
        "conceptId": "bonjour",
        "type": "vocabulary",
        "french": "Bonjour",
        "english": "Hello",
        "explanation": "A standard greeting used any time before evening.",
        "examples": [
          {
            "french": "Bonjour, je m'appelle Léa.",
            "english": "Hello, my name is Léa."
          }
        ],
        "questions": [
          {
            "question": "What does \"Bonjour\" mean?",
            "options": [
              "Goodbye",
              "Hello",
              "Please",
              "Friend"
            ],
            "correctAnswer": "Hello"
          }
        ]
      },
      {
        "conceptId": "salut",
        "type": "vocabulary",
        "french": "Salut",
        "english": "Hi",
        "explanation": "A casual greeting used with friends, not appropriate in formal settings.",
        "examples": [
          {
            "french": "Salut ! Ça va ?",
            "english": "Hi! How are you?"
          }
        ],
        "questions": [
          {
            "question": "What does \"Salut\" mean?",
            "options": [
              "Hi",
              "Goodbye",
              "Name",
              "Country"
            ],
            "correctAnswer": "Hi"
          }
        ]
      },
      {
        "conceptId": "prenom",
        "type": "vocabulary",
        "french": "Prénom",
        "english": "First name",
        "explanation": "Refers specifically to someone's given name, not their family name.",
        "examples": [
          {
            "french": "Mon prénom est Marie.",
            "english": "My first name is Marie."
          }
        ],
        "questions": [
          {
            "question": "What does \"prénom\" mean?",
            "options": [
              "Last name",
              "First name",
              "City",
              "Country"
            ],
            "correctAnswer": "First name"
          }
        ]
      },
      {
        "conceptId": "nom",
        "type": "vocabulary",
        "french": "Nom",
        "english": "Name / Last name",
        "explanation": "Can mean \"name\" in general, or specifically \"last name\" depending on context.",
        "examples": [
          {
            "french": "Quel est votre nom ?",
            "english": "What is your name?"
          }
        ],
        "questions": [
          {
            "question": "What does \"nom\" mean?",
            "options": [
              "Name",
              "Friend",
              "City",
              "Hello"
            ],
            "correctAnswer": "Name"
          }
        ]
      },
      {
        "conceptId": "ami_amie",
        "type": "vocabulary",
        "french": "Ami / Amie",
        "english": "Friend",
        "explanation": "\"Ami\" is masculine, \"amie\" is feminine — both mean \"friend\".",
        "examples": [
          {
            "french": "C'est mon ami.",
            "english": "This is my friend."
          }
        ],
        "questions": [
          {
            "question": "What does \"ami\" mean?",
            "options": [
              "Friend",
              "Name",
              "Country",
              "City"
            ],
            "correctAnswer": "Friend"
          }
        ]
      },
      {
        "conceptId": "pays",
        "type": "vocabulary",
        "french": "Pays",
        "english": "Country",
        "explanation": "Used when talking about where someone is from at the national level.",
        "examples": [
          {
            "french": "Quel est ton pays ?",
            "english": "What is your country?"
          }
        ],
        "questions": [
          {
            "question": "What does \"pays\" mean?",
            "options": [
              "City",
              "Country",
              "Friend",
              "Name"
            ],
            "correctAnswer": "Country"
          }
        ]
      },
      {
        "conceptId": "ville",
        "type": "vocabulary",
        "french": "Ville",
        "english": "City",
        "explanation": "Used when talking about where someone is from at the city level.",
        "examples": [
          {
            "french": "Ma ville est Paris.",
            "english": "My city is Paris."
          }
        ],
        "questions": [
          {
            "question": "What does \"ville\" mean?",
            "options": [
              "Country",
              "City",
              "Friend",
              "Hello"
            ],
            "correctAnswer": "City"
          }
        ]
      },
      {
