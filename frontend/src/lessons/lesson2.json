    "phrases": [
      {
        "conceptId": "je_m_appelle",
        "type": "phrase",
        "french": "Je m'appelle ...",
        "english": "My name is ...",
        "explanation": "Used to introduce yourself by name, literally \"I call myself\".",
        "examples": [
          {
            "french": "Bonjour, je m'appelle Marie.",
            "english": "Hello, my name is Marie."
          }
        ],
        "questions": [
          {
            "question": "Which phrase means \"My name is ...\"?",
            "options": [
              "Je viens de ...",
              "Je m'appelle ...",
              "Je suis de ...",
              "Comment tu t'appelles ?"
            ],
            "correctAnswer": "Je m'appelle ..."
          }
        ]
      },
      {
        "conceptId": "comment_tu_t_appelles",
        "type": "phrase",
        "french": "Comment tu t'appelles ?",
        "english": "What is your name?",
        "explanation": "The informal way to ask someone their name.",
        "examples": [
          {
            "french": "Salut ! Comment tu t'appelles ?",
            "english": "Hi! What is your name?"
          }
        ],
        "questions": [
          {
            "question": "Which question means \"What is your name?\"",
            "options": [
              "Comment tu t'appelles ?",
              "Comment ça va ?",
              "Où êtes-vous ?",
              "Qui êtes-vous ?"
            ],
            "correctAnswer": "Comment tu t'appelles ?"
          }
        ]
      },
      {
        "conceptId": "je_suis",
        "type": "phrase",
        "french": "Je suis ...",
        "english": "I am ...",
        "explanation": "Used with a name, nationality, or description to say what/who you are.",
        "examples": [
          {
            "french": "Je suis française.",
            "english": "I am French."
          }
        ],
        "questions": [
          {
            "question": "Which phrase means \"I am ...\"?",
            "options": [
              "Je suis ...",
              "Je viens ...",
              "Tu es ...",
              "Je vais ..."
            ],
            "correctAnswer": "Je suis ..."
          }
        ]
      },
      {
        "conceptId": "je_viens_de",
        "type": "phrase",
        "french": "Je viens de ...",
        "english": "I come from ...",
        "explanation": "Used to say where you are from, followed by a city or country.",
        "examples": [
          {
            "french": "Je viens de Paris.",
            "english": "I come from Paris."
          }
        ],
        "questions": [
          {
            "question": "Which phrase means \"I come from ...\"?",
            "options": [
              "Je viens de ...",
              "Je suis de ...",
              "Je vais à ...",
              "Je m'appelle ..."
            ],
            "correctAnswer": "Je viens de ..."
          },
          {
            "question": "Complete: ___ Paris.",
            "options": [
              "Je viens de",
              "Je suis",
              "Je m'appelle",
              "Je vais"
            ],
            "correctAnswer": "Je viens de"
          }
        ]
      },
      {
        "conceptId": "enchante",
        "type": "phrase",
        "french": "Enchanté(e)",
        "english": "Nice to meet you",
        "explanation": "Said right after learning someone's name for the first time.",
        "examples": [
          {
            "french": "Enchanté, Marie.",
            "english": "Nice to meet you, Marie."
          }
        ],
        "questions": [
          {
            "question": "What does \"Enchanté\" mean?",
            "options": [
              "Goodbye",
              "Nice to meet you",
              "How are you?",
              "See you soon"
            ],
            "correctAnswer": "Nice to meet you"
          }
        ]
      },
      {
        "conceptId": "ca_va",
        "type": "phrase",
        "french": "Ça va ?",
        "english": "How are you? / Are you okay?",
        "explanation": "A casual way to ask how someone is doing.",
        "examples": [
          {
            "french": "Salut ! Ça va ?",
            "english": "Hi! How are you?"
          }
        ],
        "questions": [
          {
            "question": "What does \"Ça va ?\" mean?",
            "options": [
              "How are you?",
              "What is your name?",
              "Where are you from?",
              "See you soon"
            ],
            "correctAnswer": "How are you?"
          }
        ]
      },
      {
        "conceptId": "ca_va_bien",
        "type": "phrase",
        "french": "Ça va bien",
        "english": "I'm doing well",
        "explanation": "A common, casual response to \"Ça va ?\".",
        "examples": [
          {
            "french": "Ça va bien, merci.",
            "english": "I'm doing well, thank you."
          }
        ],
        "questions": [
          {
            "question": "What does \"Ça va bien\" mean?",
            "options": [
              "I'm doing well",
              "What is your name?",
              "Goodbye",
              "See you soon"
            ],
            "correctAnswer": "I'm doing well"
          }
        ]
      },
      {
        "conceptId": "au_revoir",
        "type": "phrase",
        "french": "Au revoir",
        "english": "Goodbye",
        "explanation": "The standard way to say goodbye.",
