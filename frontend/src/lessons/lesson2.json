        ],
        "questions": [
          {
            "question": "What does \"Au revoir\" mean?",
            "options": [
              "Hello",
              "Goodbye",
              "Nice to meet you",
              "How are you?"
            ],
            "correctAnswer": "Goodbye"
          }
        ]
      },
      {
        "conceptId": "a_bientot",
        "type": "phrase",
        "french": "À bientôt",
        "english": "See you soon",
        "explanation": "A friendly way to say goodbye when you expect to see someone again soon.",
        "examples": [
          {
            "french": "Au revoir, à bientôt !",
            "english": "Goodbye, see you soon!"
          }
        ],
        "questions": [
          {
            "question": "What does \"À bientôt\" mean?",
            "options": [
              "See you soon",
              "Nice to meet you",
              "How are you?",
              "I come from"
            ],
            "correctAnswer": "See you soon"
          }
        ]
      }
    ],
    "grammar": [
      {
        "conceptId": "s_appeler",
        "type": "grammar",
        "title": "The verb s'appeler (to be called)",
        "explanation": "\"S'appeler\" is a reflexive verb used to say your name: \"je m'appelle\" (my name is) and \"tu t'appelles\" (your name is).",
        "examples": [
          {
            "french": "Je m'appelle Léa.",
            "english": "My name is Léa."
          },
          {
            "french": "Tu t'appelles Marc ?",
            "english": "Is your name Marc?"
          }
        ],
        "questions": [
          {
            "question": "Complete: Je m'___ Léa.",
            "options": [
              "appelle",
              "appelles",
              "suis",
              "viens"
            ],
            "correctAnswer": "appelle"
          },
          {
            "question": "Which form is used to ask someone's name informally?",
            "options": [
              "Comment tu t'appelles ?",
              "Comment je m'appelle ?",
              "Comment il s'appelle ?",
              "Comment vous appelle ?"
            ],
            "correctAnswer": "Comment tu t'appelles ?"
          }
        ]
      },
      {
        "conceptId": "etre",
        "type": "grammar",
        "title": "The verb être (to be) — je / tu",
        "explanation": "\"Être\" is irregular: \"je suis\" (I am) and \"tu es\" (you are), used for name, nationality, or description.",
        "examples": [
          {
            "french": "Je suis française.",
            "english": "I am French."
          },
          {
            "french": "Tu es mon ami.",
            "english": "You are my friend."
          }
        ],
        "questions": [
          {
            "question": "Complete: Je ___ française.",
            "options": [
              "suis",
              "es",
              "appelle",
              "viens"
            ],
            "correctAnswer": "suis"
          },
          {
            "question": "Which form means \"you are\"?",
            "options": [
              "Tu es",
              "Je suis",
              "Tu suis",
              "Je es"
            ],
            "correctAnswer": "Tu es"
          }
        ]
      },
      {
        "conceptId": "venir_de",
        "type": "grammar",
        "title": "Venir de (to come from)",
        "explanation": "Use \"je viens de\" + city or country to say where you are from.",
        "examples": [
          {
            "french": "Je viens de France.",
            "english": "I come from France."
          },
          {
            "french": "Je viens de Paris.",
            "english": "I come from Paris."
          }
        ],
        "questions": [
          {
            "question": "Complete: Je ___ de Paris.",
            "options": [
              "viens",
              "suis",
              "appelle",
              "vais"
            ],
            "correctAnswer": "viens"
          },
          {
            "question": "Which phrase correctly says \"I come from France\"?",
            "options": [
              "Je viens de France.",
              "Je suis de France.",
              "Je vais France.",
              "Je m'appelle France."
            ],
            "correctAnswer": "Je viens de France."
          }
        ]
      }
    ],
