        "type": "vocabulary",
        "french": "Français / Française",
        "english": "French (nationality)",
        "explanation": "\"Français\" is masculine, \"française\" is feminine, both mean the nationality \"French\".",
        "examples": [
          {
            "french": "Je suis française.",
            "english": "I am French."
          }
        ],
        "questions": [
          {
            "question": "What does \"française\" mean?",
            "options": [
              "French (nationality)",
              "Friend",
              "City",
